// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "mode": "yolo",
        "thinking_level": "medium"
      },
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "button": true,
    "dock": "left",
    "default_width": 260,
    "git_status": true,
    "auto_reveal_entries": true,
    "starts_open": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "Ayu Dark",
    "dark": "One Dark"
  },
  "agent": {
    "enabled": true,
    "button": true,
    "dock": "right",
    "flexible": false,
    "default_width": 480
  },

  "outline_panel": {
    "button": true,
    "dock": "left",
    "default_width": 260
  },
  "git_panel": {
    "button": true,
    "dock": "left",
    "default_width": 320,
    "starts_open": false
  }
}
